# Banco de Dados (PostgreSQL 16 + PostGIS)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cidade_em_foco

# Armazenamento S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000/cidade-em-foco
S3_BUCKET=cidade-em-foco
S3_REGION=us-east-1
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# E-mail (SMTP / Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Cidade em Foco <nao-responda@cidadeemfoco.gov.br>"
MAILPIT_UI_PORT=8025

# Segurança e Autenticação
# Em produção (NODE_ENV=production) a API recusa iniciar com estes valores de exemplo.
# Gere os seus: openssl rand -hex 32
JWT_ACCESS_SECRET=cf_dev_access_secret_key_change_in_prod_2026
JWT_REFRESH_SECRET=cf_dev_refresh_secret_key_change_in_prod_2026
ACCESS_TOKEN_TTL_MINUTES=15
# Duração absoluta da sessão: depois disso o usuário precisa entrar de novo (o refresh não a estende)
SESSION_MAX_HOURS=24
CONTACT_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Aplicação
API_PORT=3000
WEB_PORT=5173
# Endereço público do front, usado nos links enviados por e-mail (redefinição de senha)
WEB_PUBLIC_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081
VITE_API_URL=http://localhost:3000/api/v1

# App mobile (Expo): endereço da API visto pelo celular. Deixe vazio para detectar
# automaticamente o IP da máquina que roda o Expo.
EXPO_PUBLIC_API_URL=
